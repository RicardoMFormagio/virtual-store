@model VShop.Web.Models.ProductViewModel


<h2>Delete Product</h2>

<form asp-action="DeleteProduct">
   <div class="form-horizontal">
        <hr/>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" disabled/>
        </div>
        
        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <input asp-for="Description" class="form-control" disabled/>
        </div>

        <div class="row" >
            <div class="form-group col-md-6">
                <label asp-for="ImageURL" class="control-label"></label>
                <input asp-for="ImageURL" class="form-control" disabled/>
            </div>
            <div class="form-group col-md-6">
                <img src="~/images/@Model.ImageURL"/>
            </div>
        </div>
        
        <div class="row">
            <div class="form-group col-sm-4">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" disabled/>
            </div>
            <div class="form-group col-sm-4">
                <label asp-for="Stock" class="control-label"></label>
                <input asp-for="Stock" class="form-control" disabled/>
            </div>
        </div>
        
        <div class="form-group">
            <label asp-for="CategoryName" class="control-label"></label>
            <input asp-for="CategoryName" class="form-control" disabled/>
        </div>
        
        <div class="form-group" style="padding-top: 10px">
            <input type="submit" value="Deletar" class="btn btn-danger"/>
            <a asp-action="Index" class="btn btn-info">Back to List</a>
        </div>
    </div>
</form>